{
  "expo": {
    "name": "Autonomic",
    "slug": "autonomic",
    "version": "1.13.0",
    "scheme": "autonomic",
    "orientation": "portrait",
    "icon": "./assets/autonomic-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1a3e094e-0db6-4470-8504-c22ecef85c4d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.autonomic.journal",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Autonomic connects to your heart-rate chest strap to capture beat-to-beat data during HRV readings.",
        "NSCameraUsageDescription": "Autonomic reads your pulse through your fingertip placed over the rear camera and flash during camera HRV readings.",
        "NSMicrophoneUsageDescription": "Autonomic does not record audio. This permission is required by the camera library used for fingertip pulse readings.",
        "NSHealthShareUsageDescription": "Autonomic reads heart rate, HRV, sleep, blood pressure, blood oxygen, weight and ECG recordings from Apple Health to prefill your journal.",
        "NSHealthUpdateUsageDescription": "Autonomic can write your captured HRV readings, mindful minutes, weight, blood pressure and blood oxygen back to Apple Health.",
        "NSLocationWhenInUseUsageDescription": "Autonomic does not use your location. This permission is required by the Bluetooth library used to connect to heart-rate chest straps.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.security.application-groups": ["group.com.autonomic.journal"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/autonomic-icon.png"
    },
    "android": {
      "package": "com.autonomic.journal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0B0C"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_RESTING_HEART_RATE",
        "android.permission.health.WRITE_HEART_RATE_VARIABILITY",
        "android.permission.health.WRITE_BLOOD_PRESSURE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Autonomic connects to your heart-rate chest strap to capture beat-to-beat data during HRV readings."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Autonomic reads your pulse through your fingertip placed over the rear camera and flash during camera HRV readings.",
          "enableMicrophonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#e03127",
          "defaultChannel": "reminders"
        }
      ],
      "expo-asset",
      "expo-font",
      "react-native-iap",
      "./plugins/withFmtConstevalFix",
      "./plugins/withHealthConnect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Score",
              "label": "Autonomic Score",
              "description": "Today's autonomic score and how the day is grading.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "maxResizeHeight": "160dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ScoreMetrics",
              "label": "Score & Metrics",
              "description": "Today's score with graded SDNN, RMSSD and sleep averages.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "maxResizeHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayNumbers",
              "label": "Today's Numbers",
              "description": "SDNN, RMSSD, pNN50, resting HR, sleep and water at a glance.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "maxResizeHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StartHrv",
              "label": "Start HRV",
              "description": "Jump straight into an HRV reading.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "maxResizeHeight": "160dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none"
            },
            {
              "name": "Protocol",
              "label": "Score & Daily Protocol",
              "description": "Today's score and metrics over the clean-day protocol checklist.",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "L3YCKS64HC"
        }
      ],
      "./plugins/withWatchBuildVersion"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a3e094e-0db6-4470-8504-c22ecef85c4d"
      }
    },
    "owner": "austinspaeth"
  }
}
