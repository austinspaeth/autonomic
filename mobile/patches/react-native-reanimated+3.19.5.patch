+// The node `family` occupies in `root`, or null when it is not in that tree.
+static const ShadowNode *findInTree(
+    const ShadowNodeFamily &family,
+    const RootShadowNode &root) {
+  const auto ancestors = family.getAncestors(root);
+  if (ancestors.empty()) {
+    return nullptr;
+  }
+  const auto &[parent, index] = ancestors.back();
+  const auto &children = parent.get().getChildren();
+  return index < static_cast<int>(children.size()) ? children[index].get()
+                                                   : nullptr;
+}
